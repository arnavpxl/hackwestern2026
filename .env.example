# Tiger Cloud: copy the service connection string here (tiger service get <id> --with-password -o json)
DATABASE_URL=postgresql://postgres:tokentrueup@localhost:5433/tokentrueup
# Optional live LLM mode
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Generated automatically by make up/make demo. Keep the same value across restarts.
TTU_ENCRYPTION_KEY=
# Optional Postmark transactional email alerts for signed-in demo users.
# Use the same Postmark Server Token for both username and password.
TTU_SMTP_HOST=smtp.postmarkapp.com
TTU_SMTP_PORT=587
TTU_SMTP_USERNAME=YOUR_POSTMARK_SERVER_TOKEN
TTU_SMTP_PASSWORD=YOUR_POSTMARK_SERVER_TOKEN
TTU_SMTP_FROM="Token Up Alerts <your-verified-sender@example.com>"
TTU_SMTP_MESSAGE_STREAM=outbound
TTU_SMTP_STARTTLS=true
TTU_SMTP_SSL=false
TTU_APP_URL=http://localhost:3000
